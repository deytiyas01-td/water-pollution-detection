# ==============================================================
# WATER POLLUTION DETECTION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual private values.
# NEVER commit your '.env' file to GitHub or any public repository!
# ==============================================================

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Security Settings
# Optional API Key for securing endpoints. If empty or commented out, public web mode is active.
# When set, API requests require the 'X-API-Key' header matching this value.
API_SECRET_KEY=

# Allowed CORS Origins (comma-separated, e.g. http://localhost:3000,https://yourdomain.com or * for open)
ALLOWED_ORIGINS=*

# Path to the Grounding DINO model folder (local folder or Hugging Face repo ID)
MODEL_PATH=./Models

# Device to use: 'cuda', 'cpu', or 'auto'
DEVICE=auto

# Detection Settings
DEFAULT_BOX_THRESHOLD=0.25
DEFAULT_TEXT_THRESHOLD=0.25

# Upload Constraints
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=150
MAX_VIDEO_DURATION_SEC=180
VIDEO_SAMPLE_FPS=2.0
